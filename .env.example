# ===============================
# OCR (opsional)
# ===============================
# Gemini API key (free tier) untuk OCR foto kamera: https://aistudio.google.com/apikey
# Bisa juga diisi langsung dari aplikasi: Pengaturan > Gemini API Key (tanpa rebuild).
# Tanpa key, semua gambar diproses Tesseract.js offline.
VITE_GEMINI_API_KEY=""
# Model yang dipakai lebih dulu. Jika tidak tersedia, aplikasi mencoba model fallback otomatis.
VITE_GEMINI_MODEL="gemini-3.6-flash"

# ===============================
# Google Drive (penyimpanan foto struk)
# ===============================
# OAuth Client ID tipe "Web application" dari Google Cloud Console.
# Tambahkan origin aplikasi ke "Authorized JavaScript origins":
#   http://localhost:3000  (dan domain deploy Anda)
# Bisa juga diisi dari aplikasi: Pengaturan > Google OAuth Client ID.
VITE_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ===============================
# Supabase (PostgreSQL + Auth) - opsional
# ===============================
# Jika tidak diisi, data transaksi otomatis disimpan di localStorage dan foto di IndexedDB/Google Drive.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
